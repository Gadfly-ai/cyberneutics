# Copy to .env.local (run `npm run setup`) or set in your shell.
# Never commit .env.local — it may contain secrets.

# Optional. If unset or empty, the app uses deterministic local demo text (no network).
# Get a key from https://console.anthropic.com/ if you want live Claude calls.
ANTHROPIC_API_KEY=

# Set to 1 to force local demo mode even when ANTHROPIC_API_KEY is set.
# LOCAL_DEMO_ONLY=1

# Optional. Repo root for in-app GitHub links (no trailing slash). Use your fork if needed.
# NEXT_PUBLIC_REPO_URL=https://github.com/Gadfly-ai/cyberneutics

# Optional. Branch for /blob/... links in the UI. Default: main
# NEXT_PUBLIC_REPO_BRANCH=main
